# syntax=docker/dockerfile:1.7

# Build the Linux WebKitGTK backend on the target architecture. The final
# stage contains only the executable, so buildx can export it to the host.
FROM golang:1.25-bookworm AS build

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libgtk-3-dev \
        libwebkit2gtk-4.0-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=1 GOOS=linux GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags='-s -w' \
    -o /out/JsonForge-linux-${TARGETARCH} .

FROM scratch AS artifact
COPY --from=build /out/ /
